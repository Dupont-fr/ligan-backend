# Application
APP_NAME=LIGAN+
NODE_ENV=development
PORT=5000

# Base de données MongoDB Atlas (en ligne)
MONGODB_URI=

# Frontend (origine autorisée par CORS)
FRONTEND_URL=http://localhost:5173

# Auth (Sprint 1)
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# Email transactionnels (Sprint 1 — Brevo)
EMAIL_USER=
EMAIL_PASS=
BREVO_API_KEY=
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_FROM_NAME=LIGAN+
EMAIL_FROM=
# EMAIL_DISABLED=1  # repli DEV : log les emails au lieu de les envoyer

# Admin (Sprint 2 — créé par `npm run seed` si ADMIN_PASSWORD est défini)
ADMIN_EMAIL=admin@ligan.plus
ADMIN_PASSWORD=
