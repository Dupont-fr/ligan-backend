# Application
APP_NAME=LIGAN+
NODE_ENV=development
PORT=5000

# Base de données MongoDB Atlas (en ligne)
MONGODB_URI=

# Frontend (origine autorisée par CORS)
FRONTEND_URL=http://localhost:5173

# Auth (Sprint 1)
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# Email transactionnels (Sprint 1 — Brevo)
EMAIL_USER=
EMAIL_PASS=
BREVO_API_KEY=
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_FROM_NAME=LIGAN+
EMAIL_FROM=
# EMAIL_DISABLED=1  # repli DEV : log les emails au lieu de les envoyer

# Admin (Sprint 2 — créé par `npm run seed` si ADMIN_PASSWORD est défini)
ADMIN_EMAIL=admin@ligan.plus
ADMIN_PASSWORD=

# Bootstrap du premier admin via POST /api/auth/bootstrap-admin (api.rest)
# Optionnel : si défini, le header x-bootstrap-token doit correspondre.
BOOTSTRAP_TOKEN=

# ---------------------------------------------------------------------------
# Paiements FeexPay (Sprint 12 — abonnements)
# Procédure :
#   1. Créer un compte marchand sur https://feexpay.me → « Create an account »
#   2. Valider le compte (Account validation — informations marchand demandées
#      par FeexPay, cf. docs.feexpay.me)
#   3. Dans le Dashboard FeexPay, récupérer :
#        - le Shop ID            → FEEXPAY_SHOP_ID
#        - la clé API (fp_…)     → FEEXPAY_API_KEY
#   4. Commencer en mode TEST (sandbox) puis passer en LIVE
#   5. Configurer l'URL de callback/notification du dashboard :
#        https://VOTRE-DOMAINE/api/payments/webhook
#   6. Coller les valeurs ci-dessous puis redémarrer le backend.
# Sans clés, le paiement bascule automatiquement en mode simulation (mock).
# ---------------------------------------------------------------------------
FEEXPAY_API_KEY=
FEEXPAY_SHOP_ID=
# TEST (sandbox) ou LIVE
FEEXPAY_MODE=TEST
