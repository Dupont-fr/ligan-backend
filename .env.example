# Application
APP_NAME=LIGAN+
NODE_ENV=development
PORT=5000

# Base de données MongoDB Atlas (en ligne)
MONGODB_URI=

# Frontend (origine autorisée par CORS)
FRONTEND_URL=http://localhost:5173

# Auth (Sprint 1)
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# Email transactionnels (Sprint 1 — Brevo)
EMAIL_USER=
EMAIL_PASS=
BREVO_API_KEY=
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_FROM_NAME=LIGAN+
EMAIL_FROM=
# EMAIL_DISABLED=1  # repli DEV : log les emails au lieu de les envoyer

# Admin (Sprint 2 — créé par `npm run seed` si ADMIN_PASSWORD est défini)
ADMIN_EMAIL=admin@ligan.plus
ADMIN_PASSWORD=

# Bootstrap du premier admin via POST /api/auth/bootstrap-admin (api.rest)
# Optionnel : si défini, le header x-bootstrap-token doit correspondre.
BOOTSTRAP_TOKEN=

# ---------------------------------------------------------------------------
# Paiements SebPay (Sprint 12 — abonnements, remplace FeexPay)
# Procédure :
#   1. Compte marchand sur https://sebpay.bj (ou dashboard SebPay)
#   2. Récupérer les clés API (page API / Webhooks du dashboard) :
#        - clé publique (pk_test_… / pk_live_…) → SEBPAY_PUBLIC_KEY
#        - clé secrète  (sk_test_… / sk_live_…) → SEBPAY_SECRET_KEY
#   3. Tester d'abord en clés test, puis passer en clés live
#   4. PUBLIC_API_URL = URL publique du backend (sert de callback_url aux
#      collectes) : https://VOTRE-DOMAINE — laisser vide en local
#      (le sondage du dashboard suffit alors, pas de webhook automatique)
#   5. Devise/pays par défaut : XAF / CM (Cameroun) — surcharger si besoin
#   6. Coller les valeurs ci-dessous puis redémarrer le backend.
# Sans clés, le paiement bascule automatiquement en mode simulation (mock).
# ---------------------------------------------------------------------------
SEBPAY_PUBLIC_KEY=
SEBPAY_SECRET_KEY=
# Devise et pays ISO du compte marchand (Cameroun : XAF / CM)
SEBPAY_CURRENCY=XAF
SEBPAY_COUNTRY=CM
# URL publique du backend pour le webhook (optionnel en local)
PUBLIC_API_URL=
